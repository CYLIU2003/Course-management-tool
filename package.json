{
  "name": "timesch",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "python -m backend.server",
    "db:prepare": "node scripts/curriculum/prepare_datasets.mjs",
    "db:build": "npm run db:prepare && python -m backend.database --import",
    "db:check": "python -m backend.database",
    "test:handbooks": "node scripts/curriculum/test-handbooks.mjs",
    "test:database": "python -m unittest backend.test_database -v",
    "build": "tsc -b && vite build",
    "check:status": "node scripts/diagnostics/check-system-status.mjs",
    "check:csv": "node scripts/diagnostics/check-system-status.mjs --csv-only",
    "check:all": "npm run check:status && npm run build",
    "lint": "eslint .",
    "preview": "node scripts/dev.mjs --preview",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run verify:cloudflare && wrangler deploy",
    "test:accounts": "python -m unittest backend.test_accounts backend.test_administration -v",
    "test:supabase": "node scripts/test-supabase.mjs",
    "db:offerings": "python -m scripts.curriculum.import_offerings",
    "db:export-supabase": "python -m scripts.export_supabase",
    "dev:supabase": "node scripts/dev-supabase.mjs",
    "test:cloudflare": "node --test scripts/test-cloudflare.mjs",
    "verify:cloudflare": "npm run test:cloudflare && npm run test:google-auth && npm run test:offering-guide && npm run test:supabase && npm run build:cloudflare",
    "test:offering-guide": "node scripts/test-offering-guide.mjs",
    "test:google-auth": "node scripts/test-google-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@types/papaparse": "^5.3.16",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
